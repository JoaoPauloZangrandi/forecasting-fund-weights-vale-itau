# Dados brutos grandes ficam fora do repositório.
data/raw/*
!data/raw/README.md

# Saídas regeneráveis.
data/processed/*
!data/processed/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
!outputs/tables/load_audit.csv

# v2 OFICIAL: saídas de dado regeneráveis pelos scripts (alguns arquivos >1GB,
# muito acima do limite de 100MB do GitHub) -- só os scripts e os PDFs/figuras
# ficam versionados.
v2 OFICIAL/data/*

# LaTeX (artefatos de compilação) — mantém .tex e .pdf.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# R / sistema.
.Rhistory
.RData
.Rproj.user/
*.Rproj
Thumbs.db
desktop.ini
*.nav
*.snm
compile_log.txt
